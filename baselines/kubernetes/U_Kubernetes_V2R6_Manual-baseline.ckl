          <VULN_ATTRIBUTE>CCI_REF</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>CCI-000018 CCI-000130 CCI-000131 CCI-000132 CCI-000133 CCI-000134 CCI-000135 CCI-000172 CCI-001403 CCI-001404 CCI-001487 CCI-002264</ATTRIBUTE_DATA>
        </STIG_DATA>
