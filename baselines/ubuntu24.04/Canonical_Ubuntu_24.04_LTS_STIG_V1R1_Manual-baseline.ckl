          <VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>SV-270820r1066949_rule</ATTRIBUTE_DATA>
        </STIG_DATA>
        <STIG_DATA>
