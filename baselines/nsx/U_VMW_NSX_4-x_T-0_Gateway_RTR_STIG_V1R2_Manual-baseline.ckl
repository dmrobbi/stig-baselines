          <ATTRIBUTE_DATA />
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Potential_Impact</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA />
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Third_Party_Tools</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA />
