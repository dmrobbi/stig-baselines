        <STIG_DATA>
          <VULN_ATTRIBUTE>Rule_Title</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>The vRA PostgreSQL database must set the log_min_messages to warning.</ATTRIBUTE_DATA>
