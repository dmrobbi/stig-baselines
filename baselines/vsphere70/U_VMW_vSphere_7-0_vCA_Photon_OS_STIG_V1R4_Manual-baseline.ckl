        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Group_Title</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>SRG-OS-000032-GPOS-00013</ATTRIBUTE_DATA>
        </STIG_DATA>
