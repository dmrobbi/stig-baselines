        <STIG_DATA>
          <VULN_ATTRIBUTE>STIGRef</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>Citrix XenDesktop 7.x Receiver Security Technical Implementation Guide :: v1r2</ATTRIBUTE_DATA>
