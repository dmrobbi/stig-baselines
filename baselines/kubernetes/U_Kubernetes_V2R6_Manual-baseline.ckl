          <ATTRIBUTE_DATA>SRG-APP-000023-CTR-000055</ATTRIBUTE_DATA>
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>SV-242381r1043176_rule</ATTRIBUTE_DATA>
