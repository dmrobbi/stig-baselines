        <STIG_DATA>
          <VULN_ATTRIBUTE>STIGRef</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>VMware NSX-T Tier 1 Gateway RTR Security Technical Implementation Guide :: v1r1</ATTRIBUTE_DATA>
