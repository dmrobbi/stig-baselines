      <VULN>
        <STIG_DATA>
          <VULN_ATTRIBUTE>STIGRef</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>VMware vRealize Automation 7.x vIDM Security Technical Implementation Guide :: v1r2</ATTRIBUTE_DATA>
