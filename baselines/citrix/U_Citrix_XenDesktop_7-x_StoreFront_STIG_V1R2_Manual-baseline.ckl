        <STIG_DATA>
          <VULN_ATTRIBUTE>STIGRef</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>Citrix XenDesktop 7.x StoreFront Security Technical Implementation Guide :: v1r2</ATTRIBUTE_DATA>
