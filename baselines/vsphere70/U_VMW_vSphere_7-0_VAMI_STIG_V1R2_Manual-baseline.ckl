        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>SV-256670r888532_rule</ATTRIBUTE_DATA>
        </STIG_DATA>
        <STIG_DATA>
