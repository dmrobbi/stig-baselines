          <ATTRIBUTE_DATA />
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Mitigation_Control</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA />
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Responsibility</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA />
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>IA_Controls</VULN_ATTRIBUTE>
