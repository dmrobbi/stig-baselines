          <VULN_ATTRIBUTE>IA_Controls</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA />
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Security_Override_Guidance</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA />
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Weight</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>10.0</ATTRIBUTE_DATA>
        </STIG_DATA>
