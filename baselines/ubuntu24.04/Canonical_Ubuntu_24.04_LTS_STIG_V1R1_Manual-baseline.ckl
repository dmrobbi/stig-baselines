          <VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>SV-270690r1067126_rule</ATTRIBUTE_DATA>
        </STIG_DATA>
        <STIG_DATA>
