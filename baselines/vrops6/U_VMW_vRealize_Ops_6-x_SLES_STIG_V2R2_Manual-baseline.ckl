        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>Fix_Text</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>To remove the "telnet-server" package use the following command:

rpm -e rsh-server</ATTRIBUTE_DATA>
        </STIG_DATA>
