# for SETTING in $(/sbin/sysctl -aN --pattern "net.ipv[4|6].conf.(all|default|eth.*).mc_forwarding"); do sed -i -e "/^${SETTING}/d" /etc/sysctl.conf;echo $SETTING=0&gt;&gt;/etc/sysctl.conf; done
# /sbin/sysctl --load</ATTRIBUTE_DATA>
