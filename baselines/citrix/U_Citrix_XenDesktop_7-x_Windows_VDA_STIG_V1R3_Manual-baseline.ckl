        <STIG_DATA>
          <VULN_ATTRIBUTE>STIGRef</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>Citrix XenDesktop 7.x Windows VDA Security Technical Implementation Guide :: v1r3</ATTRIBUTE_DATA>
