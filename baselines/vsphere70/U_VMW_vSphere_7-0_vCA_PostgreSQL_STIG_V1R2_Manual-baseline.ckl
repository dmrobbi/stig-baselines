          <VULN_ATTRIBUTE>Class</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>Unclassified</ATTRIBUTE_DATA>
        </STIG_DATA>
        <STIG_DATA>
          <VULN_ATTRIBUTE>CCI_REF</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>CCI-001499</ATTRIBUTE_DATA>
        </STIG_DATA>
        <STATUS>Not_Reviewed</STATUS>
        <FINDING_DETAILS />
        <COMMENTS />
