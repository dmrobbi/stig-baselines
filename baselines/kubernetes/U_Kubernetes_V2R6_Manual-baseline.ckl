          <VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
          <ATTRIBUTE_DATA>SV-274882r1137640_rule</ATTRIBUTE_DATA>
        </STIG_DATA>
        <STIG_DATA>
